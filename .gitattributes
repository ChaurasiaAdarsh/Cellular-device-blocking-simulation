# Set default behavior to automatically normalize line endings
* text=auto

# Source code files
*.java text diff=java eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Shell scripts (must maintain LF line endings for Linux / macOS execution)
*.sh text eol=lf
mvnw text eol=lf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
